{
  "name": "stickpilot",
  "productName": "StickPilot",
  "version": "0.1.0",
  "description": "StickPilot: mirror and control a Fire TV (or other Android device) from your computer",
  "main": "dist/main/main.js",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron .",
    "debug": "node scripts/build.mjs && STICKPILOT_DEBUG=1 electron .",
    "typecheck": "tsc",
    "vendor": "node scripts/vendor.mjs",
    "helper": "node scripts/build-helper.mjs"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^26.6.3",
    "electron": "^44.4.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "mp4-muxer": "^5.2.2"
  }
}
