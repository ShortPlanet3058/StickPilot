{
  "name": "stickpilot",
  "productName": "StickPilot",
  "version": "0.1.0",
  "description": "StickPilot: mirror and control a Fire TV (or other Android device) from your computer",
  "author": "Finn Vignon",
  "main": "dist/main/main.js",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron .",
    "debug": "node scripts/build.mjs && STICKPILOT_DEBUG=1 electron .",
    "typecheck": "tsc",
    "vendor": "node scripts/vendor.mjs",
    "helper": "node scripts/build-helper.mjs",
    "dist:mac": "node scripts/build.mjs && electron-builder --mac dmg --x64",
    "keys-helper": "bash scripts/build-keys.sh",
    "dist:win": "node scripts/build.mjs && electron-builder --win nsis --x64"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^26.6.3",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "mp4-muxer": "^5.2.2",
    "qrcode-generator": "^2.0.4",
    "uiohook-napi": "^1.5.5"
  },
  "build": {
    "appId": "app.stickpilot",
    "productName": "StickPilot",
    "copyright": "Copyright © 2026 Finn Vignon",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!**/*.map",
      "!node_modules/uiohook-napi/build/**",
      "!node_modules/uiohook-napi/src/**",
      "!node_modules/uiohook-napi/libuiohook/**",
      "!node_modules/@types/**"
    ],
    "extraResources": [
      {
        "from": "vendor/scrcpy-server",
        "to": "vendor/scrcpy-server"
      },
      {
        "from": "vendor/scrcpy-LICENSE",
        "to": "vendor/scrcpy-LICENSE"
      },
      {
        "from": "helper/dist/stickpilot-helper.jar",
        "to": "helper/stickpilot-helper.jar"
      },
      {
        "from": "assets",
        "to": "assets",
        "filter": [
          "icon.png",
          "icon-512.png",
          "icon.ico"
        ]
      }
    ],
    "mac": {
      "target": "dmg",
      "icon": "assets/StickPilot.icns",
      "category": "public.app-category.utilities",
      "identity": null,
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "StickPilot connects to your TV over Wi-Fi and looks for TVs on your local network."
      },
      "hardenedRuntime": false,
      "extraResources": [
        {
          "from": "vendor/darwin-x64",
          "to": "vendor/darwin-x64"
        },
        {
          "from": "helper/dist/stickpilot-keys",
          "to": "helper/stickpilot-keys"
        }
      ]
    },
    "dmg": {
      "title": "StickPilot ${version}",
      "artifactName": "StickPilot-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "extraResources": [
        {
          "from": "vendor/win32-x64",
          "to": "vendor/win32-x64"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "StickPilot",
      "deleteAppDataOnUninstall": false,
      "artifactName": "StickPilot-${version}-win-${arch}-setup.${ext}",
      "include": "scripts/installer.nsh"
    },
    "afterSign": "scripts/sign-mac.cjs"
  }
}
